# Contact form email delivery (Resend, https://resend.com). Set these in Vercel → Project → Settings → Environment Variables.
# Server-only: never prefix them with NEXT_PUBLIC_.
RESEND_API_KEY=
# Where messages from the contact form are delivered.
CONTACT_TO_EMAIL=
# Sender shown on the email. Without a verified domain, Resend only allows onboarding@resend.dev.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Public site address, used for SEO metadata, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=
